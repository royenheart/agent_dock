{
  "name": "agent-dock",
  "displayName": "Agent Dock",
  "icon": "media/logo.png",
  "description": "Agent Dock — cross-server AI agent workspace: files of the current server plus opencode / Codex CLI / Claude Code sessions across SSH servers.",
  "version": "0.2.7",
  "publisher": "royenheart",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "untrustedWorkspaces": {
    "supported": true
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentDock",
          "title": "Agent Dock",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentDock": [
        {
          "id": "agentDock.workspace",
          "name": "%view.workspace.name%",
          "icon": "media/icon.svg",
          "contextualTitle": "Agent Workspace"
        },
        {
          "id": "agentDock.settings",
          "name": "%view.settings.name%",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentDock.workspace",
        "contents": "%welcome.content%"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "agentDock.clientTerminal",
          "title": "%cmd.openClientTerminal%",
          "icon": "$(terminal)"
        }
      ]
    },
    "configuration": {
      "title": "Agent Dock",
      "properties": {
        "agentDock.servers": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.servers.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "显示名称"
              },
              "host": {
                "type": "string",
                "description": "SSH 主机或别名"
              },
              "user": {
                "type": "string",
                "description": "SSH 用户名"
              },
              "port": {
                "type": "number",
                "description": "SSH 端口（默认 22）"
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "固定到 Agent Workspace 的远程目录（绝对路径）"
              },
              "forwards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "localPort",
                    "remotePort"
                  ],
                  "properties": {
                    "localPort": {
                      "type": "number",
                      "description": "本地监听端口"
                    },
                    "remoteHost": {
                      "type": "string",
                      "description": "目标主机（从服务器可达，默认 localhost）"
                    },
                    "remotePort": {
                      "type": "number",
                      "description": "目标端口"
                    }
                  }
                },
                "description": "SSH 本地端口转发：localhost:localPort → remoteHost:remotePort"
              }
            }
          }
        },
        "agentDock.sessionLimit": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "%config.sessionLimit.description%"
        },
        "agentDock.connectInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "%config.connectInNewWindow.description%"
        },
        "agentDock.sshTimeoutSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 120,
          "description": "%config.sshTimeoutSeconds.description%"
        },
        "agentDock.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "%config.logLevel.description%"
        },
        "agentDock.sshConnectionPersist": {
          "type": "string",
          "default": "8h",
          "pattern": "^([0-9]+[smh]?|yes|0)$",
          "description": "%config.sshConnectionPersist.description%"
        },
        "agentDock.sshTransport": {
          "type": "string",
          "default": "persistent",
          "enum": [
            "persistent",
            "spawn"
          ],
          "description": "%config.sshTransport.description%"
        },
        "agentDock.sshHostKeyMode": {
          "type": "string",
          "default": "yes",
          "enum": [
            "yes",
            "accept-new",
            "no"
          ],
          "description": "%config.sshHostKeyMode.description%"
        },
        "agentDock.remoteAutoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.remoteAutoRefresh.description%"
        },
        "agentDock.remoteWatchIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "description": "%config.remoteWatchIntervalSeconds.description%"
        },
        "agentDock.autoSave": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "afterDelay",
            "onFocusChange",
            "onWindowChange"
          ],
          "markdownDescription": "%config.autoSave.description%"
        },
        "agentDock.autoSaveDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 60000,
          "description": "%config.autoSaveDelay.description%"
        },
        "agentDock.gitStatusEnable": {
          "type": "boolean",
          "default": true,
          "description": "%config.gitStatusEnable.description%"
        },
        "agentDock.gitStatusLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 200000,
          "description": "%config.gitStatusLimit.description%"
        },
        "agentDock.gitStatusTimeoutSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 3,
          "maximum": 120,
          "description": "%config.gitStatusTimeoutSeconds.description%"
        }
      }
    },
    "commands": [
      {
        "command": "agentDock.refresh",
        "title": "%cmd.refresh%",
        "category": "Agent Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentDock.addServer",
        "title": "%cmd.addServer%",
        "category": "Agent Workspace",
        "icon": "$(add)"
      },
      {
        "command": "agentDock.removeServer",
        "title": "%cmd.removeServer%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentDock.connect",
        "title": "%cmd.connect%",
        "category": "Agent Workspace",
        "icon": "$(remote)"
      },
      {
        "command": "agentDock.connectTerminal",
        "title": "%cmd.connectTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      },
      {
        "command": "agentDock.openClientTerminal",
        "title": "%cmd.openClientTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      },
      {
        "command": "agentDock.openSession",
        "title": "%cmd.openSession%",
        "category": "Agent Workspace"
      },
      {
        "command": "agentDock.resumeSession",
        "title": "%cmd.resumeSession%",
        "category": "Agent Workspace",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentDock.copySessionId",
        "title": "%cmd.copySessionId%",
        "category": "Agent Workspace"
      },
      {
        "command": "agentDock.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Agent Workspace",
        "icon": "$(gear)"
      },
      {
        "command": "agentDock.fsOpenSide",
        "title": "%cmd.fsOpenSide%",
        "category": "Agent Workspace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentDock.fsCopyPath",
        "title": "%cmd.fsCopyPath%",
        "category": "Agent Workspace",
        "icon": "$(clippy)"
      },
      {
        "command": "agentDock.fsCopy",
        "title": "%cmd.fsCopy%",
        "category": "Agent Workspace",
        "icon": "$(copy)"
      },
      {
        "command": "agentDock.fsPaste",
        "title": "%cmd.fsPaste%",
        "category": "Agent Workspace",
        "icon": "$(paste)"
      },
      {
        "command": "agentDock.fsCopyRelativePath",
        "title": "%cmd.fsCopyRelativePath%",
        "category": "Agent Workspace",
        "icon": "$(clippy)"
      },
      {
        "command": "agentDock.fsRevealOS",
        "title": "%cmd.fsRevealOS%",
        "category": "Agent Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentDock.fsNewFile",
        "title": "%cmd.fsNewFile%",
        "category": "Agent Workspace",
        "icon": "$(new-file)"
      },
      {
        "command": "agentDock.fsNewFolder",
        "title": "%cmd.fsNewFolder%",
        "category": "Agent Workspace",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentDock.fsRename",
        "title": "%cmd.fsRename%",
        "category": "Agent Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "agentDock.fsMove",
        "title": "%cmd.fsMove%",
        "category": "Agent Workspace",
        "icon": "$(arrow-right)"
      },
      {
        "command": "agentDock.fsDownload",
        "title": "%cmd.fsDownload%",
        "category": "Agent Workspace",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentDock.fsUpload",
        "title": "%cmd.fsUpload%",
        "category": "Agent Workspace",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentDock.fsDelete",
        "title": "%cmd.fsDelete%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentDock.fsOpenTerminal",
        "title": "%cmd.fsOpenTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      },
      {
        "command": "agentDock.fsRemoveFromWorkspace",
        "title": "%cmd.fsRemoveFromWorkspace%",
        "category": "Agent Workspace",
        "icon": "$(close)"
      },
      {
        "command": "agentDock.createSession",
        "title": "%cmd.createSession%",
        "category": "Agent Workspace",
        "icon": "$(add)"
      },
      {
        "command": "agentDock.showLog",
        "title": "%cmd.showLog%",
        "category": "Agent Dock",
        "icon": "$(output)"
      },
      {
        "command": "agentDock.portForwardAdd",
        "title": "%cmd.portForwardAdd%",
        "category": "Agent Workspace",
        "icon": "$(add)"
      },
      {
        "command": "agentDock.portForwardStart",
        "title": "%cmd.portForwardStart%",
        "category": "Agent Workspace",
        "icon": "$(play)"
      },
      {
        "command": "agentDock.portForwardStop",
        "title": "%cmd.portForwardStop%",
        "category": "Agent Workspace",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentDock.portForwardRemove",
        "title": "%cmd.portForwardRemove%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentDock.remoteFsRefreshFile",
        "title": "%cmd.remoteFsRefreshFile%",
        "category": "Agent Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentDock.remoteFsRefreshDir",
        "title": "%cmd.remoteFsRefreshDir%",
        "category": "Agent Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentDock.remoteFsNewFile",
        "title": "%cmd.remoteFsNewFile%",
        "category": "Agent Workspace",
        "icon": "$(new-file)"
      },
      {
        "command": "agentDock.remoteFsNewFolder",
        "title": "%cmd.remoteFsNewFolder%",
        "category": "Agent Workspace",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentDock.remoteFsRename",
        "title": "%cmd.remoteFsRename%",
        "category": "Agent Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "agentDock.remoteFsMove",
        "title": "%cmd.remoteFsMove%",
        "category": "Agent Workspace",
        "icon": "$(arrow-right)"
      },
      {
        "command": "agentDock.remoteFsDownload",
        "title": "%cmd.remoteFsDownload%",
        "category": "Agent Workspace",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentDock.remoteFsUpload",
        "title": "%cmd.remoteFsUpload%",
        "category": "Agent Workspace",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentDock.remoteFsDelete",
        "title": "%cmd.remoteFsDelete%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentDock.remoteFsCopyPath",
        "title": "%cmd.remoteFsCopyPath%",
        "category": "Agent Workspace",
        "icon": "$(clippy)"
      },
      {
        "command": "agentDock.remoteFsCopy",
        "title": "%cmd.remoteFsCopy%",
        "category": "Agent Workspace",
        "icon": "$(copy)"
      },
      {
        "command": "agentDock.remoteFsPaste",
        "title": "%cmd.remoteFsPaste%",
        "category": "Agent Workspace",
        "icon": "$(paste)"
      },
      {
        "command": "agentDock.remoteFsOpenTerminal",
        "title": "%cmd.remoteFsOpenTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      },
      {
        "command": "agentDock.remoteFsRemoveFromWorkspace",
        "title": "%cmd.remoteFsRemoveFromWorkspace%",
        "category": "Agent Workspace",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentDock.refresh",
          "when": "view =~ /^agentDock.workspace/",
          "group": "navigation@1"
        },
        {
          "command": "agentDock.addServer",
          "when": "view =~ /^agentDock.workspace/",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentDock.connect",
          "when": "view =~ /^agentDock.workspace/ && viewItem == server.remote",
          "group": "1_connection@1"
        },
        {
          "command": "agentDock.connectTerminal",
          "when": "view =~ /^agentDock.workspace/ && viewItem == server.remote",
          "group": "1_connection@2"
        },
        {
          "command": "agentDock.removeServer",
          "when": "view =~ /^agentDock.workspace/ && viewItem == server.remote",
          "group": "2_manage@1"
        },
        {
          "command": "agentDock.resumeSession",
          "when": "view =~ /^agentDock.workspace/ && viewItem == session",
          "group": "1_session@1"
        },
        {
          "command": "agentDock.openSession",
          "when": "view =~ /^agentDock.workspace/ && viewItem == session",
          "group": "1_session@2"
        },
        {
          "command": "agentDock.copySessionId",
          "when": "view =~ /^agentDock.workspace/ && viewItem == session",
          "group": "2_session@1"
        },
        {
          "command": "agentDock.addServer",
          "when": "view =~ /^agentDock.workspace/ && viewItem == server.remote",
          "group": "2_manage@2"
        },
        {
          "command": "agentDock.fsOpenSide",
          "when": "view =~ /^agentDock.workspace/ && viewItem == fsFile",
          "group": "1_open@1"
        },
        {
          "command": "agentDock.fsNewFile",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "2_new@1"
        },
        {
          "command": "agentDock.fsNewFolder",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "2_new@2"
        },
        {
          "command": "agentDock.fsRename",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "3_modify@1"
        },
        {
          "command": "agentDock.fsMove",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "3_modify@2"
        },
        {
          "command": "agentDock.fsDelete",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "3_modify@3"
        },
        {
          "command": "agentDock.fsCopyPath",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@1"
        },
        {
          "command": "agentDock.fsCopy",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@0"
        },
        {
          "command": "agentDock.fsPaste",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "4_copy@0"
        },
        {
          "command": "agentDock.fsCopyRelativePath",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@2"
        },
        {
          "command": "agentDock.fsDownload",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@4"
        },
        {
          "command": "agentDock.fsUpload",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "4_copy@5"
        },
        {
          "command": "agentDock.fsRevealOS",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@3"
        },
        {
          "command": "agentDock.fsOpenTerminal",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "5_terminal@1"
        },
        {
          "command": "agentDock.fsRemoveFromWorkspace",
          "when": "view =~ /^agentDock.workspace/ && viewItem == folder.workspace",
          "group": "3_modify@4"
        },
        {
          "command": "agentDock.createSession",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == folder.workspace || viewItem == folder.remote)",
          "group": "1_session@0"
        },
        {
          "command": "agentDock.portForwardAdd",
          "when": "view =~ /^agentDock.workspace/ && viewItem == portsRoot",
          "group": "1_ports@1"
        },
        {
          "command": "agentDock.portForwardStart",
          "when": "view =~ /^agentDock.workspace/ && viewItem == portForward.inactive",
          "group": "1_forward@1"
        },
        {
          "command": "agentDock.portForwardStop",
          "when": "view =~ /^agentDock.workspace/ && viewItem == portForward.active",
          "group": "1_forward@1"
        },
        {
          "command": "agentDock.portForwardRemove",
          "when": "view =~ /^agentDock.workspace/ && viewItem =~ /^portForward/",
          "group": "2_manage@1"
        },
        {
          "command": "agentDock.remoteFsRefreshFile",
          "when": "view =~ /^agentDock.workspace/ && viewItem == remoteFsFile",
          "group": "1_refresh@1"
        },
        {
          "command": "agentDock.remoteFsRefreshDir",
          "when": "view =~ /^agentDock.workspace/ && viewItem == remoteFsDir",
          "group": "1_refresh@1"
        },
        {
          "command": "agentDock.remoteFsNewFile",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsDir || viewItem == folder.remote)",
          "group": "2_new@1"
        },
        {
          "command": "agentDock.remoteFsNewFolder",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsDir || viewItem == folder.remote)",
          "group": "2_new@2"
        },
        {
          "command": "agentDock.remoteFsRename",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "3_modify@1"
        },
        {
          "command": "agentDock.remoteFsMove",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "3_modify@2"
        },
        {
          "command": "agentDock.remoteFsDelete",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "3_modify@3"
        },
        {
          "command": "agentDock.remoteFsCopyPath",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "4_copy@1"
        },
        {
          "command": "agentDock.remoteFsDownload",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "4_copy@4"
        },
        {
          "command": "agentDock.remoteFsUpload",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsDir || viewItem == folder.remote)",
          "group": "4_copy@5"
        },
        {
          "command": "agentDock.remoteFsCopy",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsFile || viewItem == remoteFsDir)",
          "group": "4_copy@0"
        },
        {
          "command": "agentDock.remoteFsPaste",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsDir || viewItem == folder.remote)",
          "group": "4_copy@0"
        },
        {
          "command": "agentDock.remoteFsOpenTerminal",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == remoteFsDir || viewItem == folder.remote)",
          "group": "5_terminal@1"
        },
        {
          "command": "agentDock.remoteFsRemoveFromWorkspace",
          "when": "view =~ /^agentDock.workspace/ && viewItem == folder.remote",
          "group": "3_modify@4"
        },
        {
          "command": "agentDock.remoteFsRefreshDir",
          "when": "view =~ /^agentDock.workspace/ && (viewItem == folder.remote || viewItem == folder.workspace)",
          "group": "1_refresh@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:unit",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "xvfb-run -a node test/e2e/runTest.js",
    "test:e2e:git": "node test/e2e-git.js",
    "test:e2e:reload:phase1": "AGENTWS_RELOAD_PHASE=1 xvfb-run -a node test/e2e/runTest.js",
    "test:e2e:reload:phase2": "AGENTWS_RELOAD_PHASE=2 xvfb-run -a node test/e2e/runTest.js",
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./ && node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "demo:record": "bash scripts/record-demo.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "marked": "^18.0.6",
    "mocha": "^11.7.6",
    "typescript": "^5.7.0",
