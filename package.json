{
  "name": "agent-workspace",
  "displayName": "Agent Workspace",
  "description": "Unified workspace view: files of the current server plus AI agent sessions (opencode, Codex CLI, Claude Code) across multiple SSH servers.",
  "version": "0.0.1",
  "publisher": "royenheart",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "untrustedWorkspaces": {
    "supported": true
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentWorkspace",
          "title": "%view.container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "agentWorkspace.workspaceExplorer",
          "name": "%view.container.title%",
          "icon": "media/icon.svg",
          "contextualTitle": "Agent Workspace"
        }
      ],
      "agentWorkspace": [
        {
          "id": "agentWorkspace.workspace",
          "name": "%view.workspace.name%",
          "icon": "media/icon.svg",
          "contextualTitle": "Agent Workspace"
        },
        {
          "id": "agentWorkspace.settings",
          "name": "%view.settings.name%",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentWorkspace.workspace",
        "contents": "%welcome.content%"
      },
      {
        "view": "agentWorkspace.workspaceExplorer",
        "contents": "%welcome.content%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agentWorkspace.servers": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.servers.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "显示名称"
              },
              "host": {
                "type": "string",
                "description": "SSH 主机或别名"
              },
              "user": {
                "type": "string",
                "description": "SSH 用户名"
              },
              "port": {
                "type": "number",
                "description": "SSH 端口（默认 22）"
              }
            }
          }
        },
        "agentWorkspace.sessionLimit": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "%config.sessionLimit.description%"
        },
        "agentWorkspace.connectInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "%config.connectInNewWindow.description%"
        }
      }
    },
    "commands": [
      {
        "command": "agentWorkspace.refresh",
        "title": "%cmd.refresh%",
        "category": "Agent Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentWorkspace.addServer",
        "title": "%cmd.addServer%",
        "category": "Agent Workspace",
        "icon": "$(add)"
      },
      {
        "command": "agentWorkspace.removeServer",
        "title": "%cmd.removeServer%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentWorkspace.connect",
        "title": "%cmd.connect%",
        "category": "Agent Workspace",
        "icon": "$(remote)"
      },
      {
        "command": "agentWorkspace.connectTerminal",
        "title": "%cmd.connectTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      },
      {
        "command": "agentWorkspace.openSession",
        "title": "%cmd.openSession%",
        "category": "Agent Workspace"
      },
      {
        "command": "agentWorkspace.resumeSession",
        "title": "%cmd.resumeSession%",
        "category": "Agent Workspace",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentWorkspace.copySessionId",
        "title": "%cmd.copySessionId%",
        "category": "Agent Workspace"
      },
      {
        "command": "agentWorkspace.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Agent Workspace",
        "icon": "$(gear)"
      },
      {
        "command": "agentWorkspace.fsOpenSide",
        "title": "%cmd.fsOpenSide%",
        "category": "Agent Workspace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentWorkspace.fsCopyPath",
        "title": "%cmd.fsCopyPath%",
        "category": "Agent Workspace",
        "icon": "$(clippy)"
      },
      {
        "command": "agentWorkspace.fsCopyRelativePath",
        "title": "%cmd.fsCopyRelativePath%",
        "category": "Agent Workspace",
        "icon": "$(clippy)"
      },
      {
        "command": "agentWorkspace.fsRevealOS",
        "title": "%cmd.fsRevealOS%",
        "category": "Agent Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentWorkspace.fsNewFile",
        "title": "%cmd.fsNewFile%",
        "category": "Agent Workspace",
        "icon": "$(new-file)"
      },
      {
        "command": "agentWorkspace.fsNewFolder",
        "title": "%cmd.fsNewFolder%",
        "category": "Agent Workspace",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentWorkspace.fsRename",
        "title": "%cmd.fsRename%",
        "category": "Agent Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "agentWorkspace.fsDelete",
        "title": "%cmd.fsDelete%",
        "category": "Agent Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "agentWorkspace.fsOpenTerminal",
        "title": "%cmd.fsOpenTerminal%",
        "category": "Agent Workspace",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentWorkspace.refresh",
          "when": "view =~ /^agentWorkspace.workspace/",
          "group": "navigation@1"
        },
        {
          "command": "agentWorkspace.addServer",
          "when": "view =~ /^agentWorkspace.workspace/",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentWorkspace.connect",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == server.remote",
          "group": "1_connection@1"
        },
        {
          "command": "agentWorkspace.connectTerminal",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == server.remote",
          "group": "1_connection@2"
        },
        {
          "command": "agentWorkspace.removeServer",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == server.remote",
          "group": "2_manage@1"
        },
        {
          "command": "agentWorkspace.resumeSession",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == session",
          "group": "1_session@1"
        },
        {
          "command": "agentWorkspace.openSession",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == session",
          "group": "1_session@2"
        },
        {
          "command": "agentWorkspace.copySessionId",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == session",
          "group": "2_session@1"
        },
        {
          "command": "agentWorkspace.addServer",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == server.remote",
          "group": "2_manage@2"
        },
        {
          "command": "agentWorkspace.fsOpenSide",
          "when": "view =~ /^agentWorkspace.workspace/ && viewItem == fsFile",
          "group": "1_open@1"
        },
        {
          "command": "agentWorkspace.fsNewFile",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "2_new@1"
        },
        {
          "command": "agentWorkspace.fsNewFolder",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "2_new@2"
        },
        {
          "command": "agentWorkspace.fsRename",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "3_modify@1"
        },
        {
          "command": "agentWorkspace.fsDelete",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "3_modify@2"
        },
        {
          "command": "agentWorkspace.fsCopyPath",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@1"
        },
        {
          "command": "agentWorkspace.fsCopyRelativePath",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@2"
        },
        {
          "command": "agentWorkspace.fsRevealOS",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsFile || viewItem == fsDir)",
          "group": "4_copy@3"
        },
        {
          "command": "agentWorkspace.fsOpenTerminal",
          "when": "view =~ /^agentWorkspace.workspace/ && (viewItem == fsDir || viewItem == folder.workspace)",
          "group": "5_terminal@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:unit",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "xvfb-run -a node test/e2e/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "typescript": "^5.7.0"
  },
  "l10n": "./l10n",
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.6"
  }
}